# Конфиг для production-варианта с Caddy (docker-compose.caddy.yml).
# Скопируй в .env и заполни. Файл .env в git не коммитится (см. .gitignore).

# Адрес, на котором Caddy обслуживает сервис.
#   localhost            — для локальной проверки (self-signed сертификат)
#   disk.example.com     — публичный домен (Caddy сам получит Let's Encrypt)
SITE_ADDRESS=localhost

# Логин для basic-auth.
BASIC_AUTH_USER=admin

# --- Темп запросов к API Диска (необязательно) ---
# Лимит на один IP и клиент: 40 запросов/с на чтение, 5 на изменение.
# Скачивание и листинг — чтение. Публикация, сохранение и загрузка — изменение.
# Ловите 429 в логе — снижайте и перезапустите.
# DISK_API_READ_RPS=40
# DISK_API_WRITE_RPS=5
# HTTP_TIMEOUT_SEC=120
# SPACE_CHECK=1   # сверка места до переноса (нужен cloud_api:disk.info)
# Локальное сохранение пишет в ./downloads/<email>/ рядом с compose-файлом
# (том ./downloads:/downloads). Менять путь в контейнере: LOCAL_SAVE_DIR.

# bcrypt-хеш пароля. Сгенерируй командой (подставь свой пароль):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ВАШ_ПАРОЛЬ' | sed 's/\$/\$\$/g'
# sed удваивает $ → $$ — ИНАЧЕ docker compose интерпретирует $ как переменные и
# съест часть хеша (basic-auth перестанет пускать). Символы $$ оставь как есть.
BASIC_AUTH_HASH=
